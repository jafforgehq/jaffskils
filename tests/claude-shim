#!/usr/bin/env bash
# Test stand-in for `claude`: logs each call to $CLAUDE_SHIM_LOG, fails the call
# whose arguments equal $CLAUDE_SHIM_FAIL, and passes everything else to
# $REAL_CLAUDE. Tests put a `claude` symlink to this file first on PATH.
if [[ -n ${CLAUDE_SHIM_LOG:-} ]]; then
  echo "$*" >>"$CLAUDE_SHIM_LOG"
fi
if [[ -n ${CLAUDE_SHIM_FAIL:-} && "$*" == "$CLAUDE_SHIM_FAIL" ]]; then
  echo "shim: forced failure" >&2
  exit 1
fi
exec "$REAL_CLAUDE" "$@"
